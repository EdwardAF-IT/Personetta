{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe Export",
  "description": "Self-contained export of one composed recipe (personetta recipe <name> --format json). The hash is sha256 over the canonical composed content (every field except version and hash), not file bytes.",
  "type": "object",
  "required": [
    "recipe",
    "version",
    "hash",
    "composed_from",
    "model_recommendation",
    "guidelines",
    "verification",
    "tone",
    "output_format"
  ],
  "additionalProperties": false,
  "properties": {
    "recipe": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "composed_from": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "model_recommendation": {
      "type": "object",
      "required": ["tier", "reasoning"],
      "additionalProperties": false,
      "properties": {
        "tier": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" }
      }
    },
    "guidelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "description": "Ids other composed roles give this same wording (the merge keeps one copy); a finding citing any of them resolves to this item.",
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "description": "Per-language size limits; present only when a class-design role supplies them.",
      "required": ["language"],
      "minProperties": 2,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "properties": { "language": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-V[0-9]+$" },
          "check": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "description": "Ids other composed roles give this same wording (the merge keeps one copy); a finding citing any of them resolves to this item.",
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-V[0-9]+$" }
          }
        }
      }
    },
    "tone": { "type": "string" },
    "output_format": { "type": "string" }
  }
}
